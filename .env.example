# ===================================================
# World as a Classroom — Environment Variables
# ===================================================

# Gemini Multimodal API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Multimodal API Key (Optional alternative: GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Connection URL:
# 1. SQLite (Default, ready out of the box with zero setup):
DATABASE_URL=sqlite+aiosqlite:///./world_classroom.db

# 2. PostgreSQL (Optional production database):
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/world_classroom

# JWT Secret Key
SECRET_KEY=world-as-a-classroom-super-secret-key-2026
